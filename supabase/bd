-- ============================================================
-- LIQUIDACION DE LOTES Y PAGOS PARCIALES
-- ============================================================

CREATE TABLE IF NOT EXISTS liquidacion_configuraciones (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    nombre VARCHAR(120) NOT NULL,
    propietario_nombre VARCHAR(120) NOT NULL DEFAULT 'Yo',
    companero_nombre VARCHAR(120) NOT NULL DEFAULT 'Compañero',
    porcentaje_ganancia_propietario DECIMAL(7,4) NOT NULL DEFAULT 0,
    porcentaje_ganancia_companero DECIMAL(7,4) NOT NULL DEFAULT 0,
    activa BOOLEAN NOT NULL DEFAULT true,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT liquidacion_config_porcentajes CHECK (
        porcentaje_ganancia_propietario >= 0 AND porcentaje_ganancia_companero >= 0 AND
        porcentaje_ganancia_propietario + porcentaje_ganancia_companero <= 100
    )
);

CREATE TABLE IF NOT EXISTS liquidaciones (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    lote_id UUID NOT NULL REFERENCES lotes(id) ON DELETE RESTRICT,
    corte_caja_id UUID,
    configuracion_id UUID REFERENCES liquidacion_configuraciones(id) ON DELETE SET NULL,
    propietario_nombre VARCHAR(120) NOT NULL,
    companero_nombre VARCHAR(120) NOT NULL,
    porcentaje_ganancia_propietario DECIMAL(7,4) NOT NULL DEFAULT 0,
    porcentaje_ganancia_companero DECIMAL(7,4) NOT NULL DEFAULT 0,
    inversion_total DECIMAL(12,2) NOT NULL DEFAULT 0,
    ventas_total DECIMAL(12,2) NOT NULL DEFAULT 0,
    ganancia_total DECIMAL(12,2) NOT NULL DEFAULT 0,
    estado VARCHAR(30) NOT NULL DEFAULT 'pendiente',
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT liquidacion_lote_corte_unique UNIQUE (lote_id, corte_caja_id)
);

CREATE TABLE IF NOT EXISTS liquidacion_conceptos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    liquidacion_id UUID NOT NULL REFERENCES liquidaciones(id) ON DELETE RESTRICT,
    persona VARCHAR(120) NOT NULL,
    concepto VARCHAR(60) NOT NULL,
    monto_total DECIMAL(12,2) NOT NULL DEFAULT 0,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT liquidacion_concepto_monto CHECK (monto_total >= 0)
);

CREATE TABLE IF NOT EXISTS pagos_liquidacion (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    liquidacion_id UUID NOT NULL REFERENCES liquidaciones(id) ON DELETE RESTRICT,
    concepto_id UUID NOT NULL REFERENCES liquidacion_conceptos(id) ON DELETE RESTRICT,
    corte_caja_id UUID,
    persona VARCHAR(120) NOT NULL,
    concepto VARCHAR(60) NOT NULL,
    monto DECIMAL(12,2) NOT NULL,
    estado VARCHAR(20) NOT NULL DEFAULT 'activo',
    pago_reversion_id UUID REFERENCES pagos_liquidacion(id) ON DELETE RESTRICT,
    nota TEXT,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT pago_liquidacion_monto CHECK (monto > 0)
);

CREATE INDEX IF NOT EXISTS idx_liquidaciones_lote ON liquidaciones(lote_id);
CREATE INDEX IF NOT EXISTS idx_liquidaciones_corte ON liquidaciones(corte_caja_id);
CREATE INDEX IF NOT EXISTS idx_liquidacion_conceptos_liquidacion ON liquidacion_conceptos(liquidacion_id);
CREATE INDEX IF NOT EXISTS idx_pagos_liquidacion_liquidacion ON pagos_liquidacion(liquidacion_id);

ALTER TABLE liquidacion_configuraciones ENABLE ROW LEVEL SECURITY;
ALTER TABLE liquidaciones ENABLE ROW LEVEL SECURITY;
ALTER TABLE liquidacion_conceptos ENABLE ROW LEVEL SECURITY;
ALTER TABLE pagos_liquidacion ENABLE ROW LEVEL SECURITY;

DO $$
DECLARE table_name TEXT;
BEGIN
    FOREACH table_name IN ARRAY ARRAY['liquidacion_configuraciones', 'liquidaciones', 'liquidacion_conceptos', 'pagos_liquidacion'] LOOP
        EXECUTE format('GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.%I TO anon', table_name);
        EXECUTE format('DROP POLICY IF EXISTS pos_anon_select ON public.%I', table_name);
        EXECUTE format('CREATE POLICY pos_anon_select ON public.%I FOR SELECT TO anon USING (true)', table_name);
        EXECUTE format('DROP POLICY IF EXISTS pos_anon_insert ON public.%I', table_name);
        EXECUTE format('CREATE POLICY pos_anon_insert ON public.%I FOR INSERT TO anon WITH CHECK (true)', table_name);
        EXECUTE format('DROP POLICY IF EXISTS pos_anon_update ON public.%I', table_name);
        EXECUTE format('CREATE POLICY pos_anon_update ON public.%I FOR UPDATE TO anon USING (true) WITH CHECK (true)', table_name);
        EXECUTE format('DROP POLICY IF EXISTS pos_anon_delete ON public.%I', table_name);
        EXECUTE format('CREATE POLICY pos_anon_delete ON public.%I FOR DELETE TO anon USING (true)', table_name);
    END LOOP;
END $$;

INSERT INTO liquidacion_configuraciones (nombre, propietario_nombre, companero_nombre, porcentaje_ganancia_propietario, porcentaje_ganancia_companero)
SELECT 'Configuración inicial', 'Yo', 'Compañero', 0, 0
WHERE NOT EXISTS (SELECT 1 FROM liquidacion_configuraciones);

REVOKE DELETE ON public.liquidaciones FROM anon;
REVOKE DELETE ON public.liquidacion_conceptos FROM anon;
REVOKE DELETE ON public.pagos_liquidacion FROM anon;
DROP POLICY IF EXISTS pos_anon_delete ON public.liquidaciones;
DROP POLICY IF EXISTS pos_anon_delete ON public.liquidacion_conceptos;
DROP POLICY IF EXISTS pos_anon_delete ON public.pagos_liquidacion;



