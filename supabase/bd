-- ============================================================

ALTER TABLE ventas
ADD COLUMN IF NOT EXISTS corte_caja_id UUID;

DO $$
BEGIN
    IF NOT EXISTS (
        SELECT 1
        FROM pg_constraint
        WHERE conname = 'fk_ventas_corte'
    ) THEN

        ALTER TABLE ventas
        ADD CONSTRAINT fk_ventas_corte
        FOREIGN KEY (corte_caja_id)
        REFERENCES cortes_caja(id)
        ON UPDATE NO ACTION
        ON DELETE SET NULL;

    END IF;
END $$;


