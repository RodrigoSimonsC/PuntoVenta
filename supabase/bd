-- ==========================================
-- Base de datos para Supabase (PostgreSQL)
-- Sistema de Inventario / Punto de Venta
-- ==========================================

-- Extensión para UUID (ya viene disponible en Supabase)
CREATE EXTENSION IF NOT EXISTS pgcrypto;

-- ==========================================
-- TABLA: productos
-- ==========================================

CREATE TABLE IF NOT EXISTS productos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    nombre VARCHAR(255) NOT NULL,
    precio_venta DECIMAL(10,2) NOT NULL,
    costo_unitario DECIMAL(10,2) NOT NULL DEFAULT 0,
    categoria VARCHAR(255),
    imagen_url TEXT,
    stock_tienda INTEGER NOT NULL DEFAULT 0,
    stock_almacen INTEGER NOT NULL DEFAULT 0,
    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: movimientos_inventario
-- ==========================================

CREATE TABLE IF NOT EXISTS movimientos_inventario (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    producto_id UUID NOT NULL REFERENCES productos(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    tipo VARCHAR(30) NOT NULL,

    delta_stock_tienda INTEGER NOT NULL DEFAULT 0,
    delta_stock_almacen INTEGER NOT NULL DEFAULT 0,

    nota TEXT,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: lotes
-- ==========================================

CREATE TABLE IF NOT EXISTS lotes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    nombre VARCHAR(255) NOT NULL,
    nota TEXT,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: lote_productos
-- ==========================================

CREATE TABLE IF NOT EXISTS lote_productos (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    lote_id UUID NOT NULL REFERENCES lotes(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    producto_id UUID NOT NULL REFERENCES productos(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    cantidad_loteada INTEGER NOT NULL DEFAULT 0,
    cantidad_vendida INTEGER NOT NULL DEFAULT 0,

    valor_inicial DECIMAL(10,2) NOT NULL DEFAULT 0,
    inversion_inicial DECIMAL(10,2) NOT NULL DEFAULT 0,
    ganancia_inicial DECIMAL(10,2) NOT NULL DEFAULT 0,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT lote_productos_unique UNIQUE (lote_id, producto_id)
);

-- Permite eliminar un producto aunque siga asociado a un lote.
ALTER TABLE public.lote_productos
    DROP CONSTRAINT IF EXISTS lote_productos_producto_id_fkey;

ALTER TABLE public.lote_productos
    ADD CONSTRAINT lote_productos_producto_id_fkey
    FOREIGN KEY (producto_id) REFERENCES public.productos(id)
    ON DELETE CASCADE
    ON UPDATE NO ACTION;

DROP TRIGGER IF EXISTS prevent_duplicate_product_lot_trigger ON public.lote_productos;
DROP FUNCTION IF EXISTS public.prevent_duplicate_product_lot();

-- ==========================================
-- TABLA: cuentas_por_cobrar
-- ==========================================

CREATE TABLE IF NOT EXISTS cuentas_por_cobrar (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    titular VARCHAR(255) NOT NULL,
    telefono VARCHAR(50),
    nota TEXT,

    saldo_inicial DECIMAL(10,2) NOT NULL DEFAULT 0,
    saldo_actual DECIMAL(10,2) NOT NULL DEFAULT 0,

    estado VARCHAR(20) NOT NULL DEFAULT 'activa',

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: ventas
-- ==========================================

CREATE TABLE IF NOT EXISTS ventas (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    fecha_hora TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    metodo_pago VARCHAR(30) NOT NULL,
    cliente_nota TEXT,

    cuenta_por_cobrar_id UUID REFERENCES cuentas_por_cobrar(id)
        ON DELETE SET NULL
        ON UPDATE NO ACTION,

    total DECIMAL(10,2) NOT NULL DEFAULT 0,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: movimientos_cuenta
-- ==========================================

CREATE TABLE IF NOT EXISTS movimientos_cuenta (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    cuenta_id UUID NOT NULL REFERENCES cuentas_por_cobrar(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    tipo VARCHAR(20) NOT NULL,

    monto DECIMAL(10,2) NOT NULL,

    nota TEXT,

    venta_id UUID REFERENCES ventas(id)
        ON DELETE SET NULL
        ON UPDATE NO ACTION,

    creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- ==========================================
-- TABLA: venta_detalles
-- ==========================================

CREATE TABLE IF NOT EXISTS venta_detalles (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    venta_id UUID NOT NULL REFERENCES ventas(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    producto_id UUID NOT NULL REFERENCES productos(id)
        ON DELETE RESTRICT
        ON UPDATE NO ACTION,

    lote_id UUID REFERENCES lotes(id)
        ON DELETE SET NULL
        ON UPDATE NO ACTION,

    cantidad INTEGER NOT NULL,

    precio_unitario DECIMAL(10,2) NOT NULL,

    subtotal DECIMAL(10,2) NOT NULL
);

-- ==========================================
-- TABLA: asignacion_deuda_lotes
-- ==========================================

CREATE TABLE IF NOT EXISTS asignacion_deuda_lotes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

    cuenta_id UUID NOT NULL REFERENCES cuentas_por_cobrar(id)
        ON DELETE CASCADE
        ON UPDATE NO ACTION,

    lote_id UUID REFERENCES lotes(id)
        ON DELETE SET NULL
        ON UPDATE NO ACTION,

    monto_pendiente DECIMAL(10,2) NOT NULL DEFAULT 0,

    actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT asignacion_deuda_lotes_unique UNIQUE (cuenta_id, lote_id)
);

-- ==========================================
-- ÍNDICES (Recomendado para Supabase)
